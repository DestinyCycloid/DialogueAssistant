<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <ProjectReference Include="..\DialogueAssistant.Core\DialogueAssistant.Core.csproj" />
    <ProjectReference Include="..\DialogueAssistant.Windows\DialogueAssistant.Windows.csproj" />
    <ProjectReference Include="..\DialogueAssistant.Recognition\DialogueAssistant.Recognition.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- 发布独立版时只携带程序实际使用的 PP-OCRv6 模型，避免把资产包中的其他游戏模型一并分发。 -->
  <Target Name="FilterDialogueAssistantPublishFiles" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('Assets\Model\')) and '%(ResolvedFileToPublish.RelativePath)' != 'Assets\Model\LICENSE' and '%(ResolvedFileToPublish.RelativePath)' != 'Assets\Model\PaddleOCR\LICENSE' and '%(ResolvedFileToPublish.RelativePath)' != 'Assets\Model\PaddleOCR\Det\V6\PP-OCRv6_small_det_infer\slim.onnx' and '%(ResolvedFileToPublish.RelativePath)' != 'Assets\Model\PaddleOCR\Det\V6\PP-OCRv6_small_det_infer\inference.yml' and '%(ResolvedFileToPublish.RelativePath)' != 'Assets\Model\PaddleOCR\Rec\V6\PP-OCRv6_small_rec_infer\slim.onnx' and '%(ResolvedFileToPublish.RelativePath)' != 'Assets\Model\PaddleOCR\Rec\V6\PP-OCRv6_small_rec_infer\inference.yml'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').EndsWith('.pdb')) or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').EndsWith('.lib'))" />
    </ItemGroup>
  </Target>

</Project>
